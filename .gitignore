# Generated site output — rebuilt by `npm run draw` / `npm run build:site`,
# never source of truth. Deployed to GitHub Pages by a CI workflow that
# builds it fresh, so it must never be committed (filenames carry the
# unguessable reveal tokens — see CLAUDE.md).
site/*
!site/.gitkeep
