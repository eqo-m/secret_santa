# Get a real key from https://resend.com/api-keys (free tier is fine for this volume).
# Copy this file to .env and fill in the real value — .env is gitignored.
RESEND_API_KEY=re_REPLACE_WITH_REAL_KEY

# Must be a domain/address verified in your Resend account, e.g. "Secret Santa <santa@yourdomain.com>".
FROM_EMAIL=Secret Santa <santa@example.com>

# Base URL where you'll deploy the contents of site/ (GitHub Pages, Netlify, etc).
# Used to build each person's reveal link in their email. No trailing slash.
SITE_BASE_URL=https://example.github.io/secret-santa
