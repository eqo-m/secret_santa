# Your Gmail address, e.g. youraddress@gmail.com. Also used as the "from" address.
GMAIL_USER=youraddress@gmail.com

# A 16-character Gmail App Password — NOT your regular login password.
# Requires 2FA on the account. Generate one at:
# https://myaccount.google.com/apppasswords
# Copy this file to .env and fill in the real value — .env is gitignored.
GMAIL_APP_PASSWORD=REPLACE_WITH_16_CHAR_APP_PASSWORD

# Base URL where you'll deploy the contents of site/ (GitHub Pages, Netlify, etc).
# Used to build each person's reveal link in their email. No trailing slash.
SITE_BASE_URL=https://example.github.io/secret-santa
